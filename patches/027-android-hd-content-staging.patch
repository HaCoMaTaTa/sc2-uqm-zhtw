+// -------------------------------------------------------------------------
+// zh-TW port: stage the required content files into build/uqm-content-staged/
+// so that AGP packages them under assets/uqm-content/ inside the APK.
+//
+// Layout inside the APK (relative to assets/):
+//   uqm-content/version                       (20 B)
+//   uqm-content/gamecontrollerdb.txt          (~570 KB, joystick mapping DB)
+//   uqm-content/packages/mm-0.8.5-content.uqm (~25 MB, base game SD)
+//   uqm-content/addons/mm-hd.uqm              (~232 MB, MegaMod HD assets)
+//   uqm-content/addons/zh-TW.uqm              (~38 MB, SD zh-TW addon)
+//   uqm-content/addons/zh-TW-hd.uqm           (~82 MB, HD zh-TW font addon)
+//
+// Total shipped payload ~380 MB. This APK is side-load only (Play Store limit
+// is 200 MB per APK; use App Bundles + asset packs for Play distribution).
+// -------------------------------------------------------------------------
+val uqmContentRoot: File = rootProject.file("../../../uqm-work/install/content")
+val stagedContentDir = layout.buildDirectory.dir("uqm-content-staged/uqm-content")
+val requiredContentPaths = listOf(
+    "version",
+    "gamecontrollerdb.txt",
+    "packages/mm-0.8.5-content.uqm",
+    "addons/mm-hd.uqm",
+    "addons/zh-TW.uqm",
+    "addons/zh-TW-hd.uqm"
+)
+
+val stageUqmContent by tasks.registering(Copy::class) {
+    description = "Stage UQM content pack + zh-TW SD addon for APK inclusion."
+    group = "uqm"
+    // Capture as plain File / List<String> so the task action is configuration-
+    // cache safe (no captured Project/Task references from the enclosing script).
+    val root = uqmContentRoot
+    val required = requiredContentPaths
+    into(stagedContentDir)
+    from(root) {
+        for (p in required) include(p)
+    }
+    doFirst {
+        val missing = required.filter { !File(root, it).exists() }
+        if (missing.isNotEmpty()) {
+            throw GradleException(
+                "UQM content missing from $root: $missing\n" +
+                        "Run desktop MegaMod installer + package_zh-TW.ps1 first."
+            )
+        }
+    }
+}
+
+// Chain the staging task in front of anything that reads assets. AGP variants
+// register mergeAssets tasks dynamically per build type/variant, so hook via
+// the `preBuild` lifecycle task (safe: runs before any variant compile step).
+tasks.named("preBuild") {
+    dependsOn(stageUqmContent)
+}
+
