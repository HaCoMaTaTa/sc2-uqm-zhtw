+/**
+ * zh-TW Android port ΓÇö v2 touch overlay.
+ *
+ * Design (see Stage 4 runbook for full analysis):
+ *  - Bottom-left  : 360┬░ virtual analog stick. Push in any direction ΓåÆ emit
+ *                   [KeyEvent.KEYCODE_DPAD_UP] (thrust) + LEFT/RIGHT based on
+ *                   the horizontal component of the stick displacement. This
+ *                   translates *at the input layer* into UQM's classic
+ *                   `Γåæ + ΓåÉ/ΓåÆ` combo without touching any engine physics.
+ *  - Bottom-right : Weapon (KEYCODE_ENTER) and Special (KEYCODE_SHIFT_RIGHT)
+ *                   circular action buttons.
+ *  - Top-right    : ESC (KEYCODE_ESCAPE) ΓÇö pause / menu / back.
+ *
+ * Menu compromise: pushing the stick nearly-straight-down (|y| > 0.7┬╖R with
+ * |x| < 0.15┬╖R) emits [KeyEvent.KEYCODE_DPAD_DOWN] *instead of* Up, so save-
+ * game slots and dialog choice lists remain navigable. Straight-up remains
+ * Up. Any diagonal push always emits Up (matches user spec: "push any
+ * direction = thrust + turn"). Combat uses Up/Left/Right only ΓÇö Down is
+ * inert in melee, so the menu-navigate carve-out is harmless there.
+ */
+@Composable
+fun TouchOverlay(modifier: Modifier = Modifier) {
+    val mode by OverlayPrefs.modeState
+    val baseAlpha by OverlayPrefs.alphaState
+    val scale by OverlayPrefs.scaleState
+    val autoHideSec by OverlayPrefs.autoHideSecondsState
+
+    // --------- Auto-hide state ---------
+    // lastInteraction: wall-clock ms of the most recent overlay touch. Any
+    // button/stick tap resets this via [markInteraction]. LaunchedEffect
+    // ticks every autoHideSec and recomputes isFaded.
+    val lastInteraction = remember { mutableLongStateOf(System.currentTimeMillis()) }
+    var isFaded by remember { mutableStateOf(false) }
+    LaunchedEffect(autoHideSec, lastInteraction.longValue) {
+        if (autoHideSec <= 0) {
+            isFaded = false
+            return@LaunchedEffect
+        }
+        isFaded = false
+        delay(autoHideSec * 1000L)
+        // Re-check: if no fresh interaction happened during the delay,
+        // fade out. Otherwise a new LaunchedEffect will restart the timer.
+        if (System.currentTimeMillis() - lastInteraction.longValue >=
+                autoHideSec * 1000L) {
+            isFaded = true
+        }
+    }
+    val effectiveAlpha by animateFloatAsState(
+        targetValue = if (isFaded) 0.15f else baseAlpha,
+        animationSpec = tween(durationMillis = 400),
+        label = "overlay-alpha",
+    )
+
+    // Reset auto-hide timer whenever anything in the overlay is touched.
+    // We reset from every button (see [markInteraction] passed into each).
+    val markInteraction: () -> Unit = remember {
+        { lastInteraction.longValue = System.currentTimeMillis() }
+    }
+
+    // --------- Dropdown / dialog state ---------
+    var menuOpen by remember { mutableStateOf(false) }
+    var settingsOpen by remember { mutableStateOf(false) }
+
+    // Grab the Context once at composable scope so lambdas below can use
+    // it without needing to re-enter @Composable context (LocalContext.current
+    // is a composable read, not lambda-safe).
+    val ctx = LocalContext.current
+
+    // Sizing helpers: prefs scale multiplier applied to every dp constant.
+    val s = { d: Dp -> (d.value * scale).dp }
+
+    Box(modifier = modifier.fillMaxSize()) {
+        // --------- Full-screen pinch detector layer ---------
+        PinchZoomDetector()
+
+        // Everything below inherits the auto-hide fade + user alpha pref.
+        Box(modifier = Modifier.fillMaxSize().alpha(effectiveAlpha)) {
+
+            // ============ TOP-LEFT cluster ============
+            //
+            //   [Γÿ░]  [C/M]  [Γî¿]
+            //   [ESC]
+            //
+            // The hamburger anchors a DropdownMenu with the less-used
+            // hotkeys (F3/F4/F6/F7/F10, keyboard shortcut, settings...).
+            Column(
+                modifier = Modifier
+                    .align(Alignment.TopStart)
+                    .padding(top = 20.dp, start = 24.dp),
+                verticalArrangement = Arrangement.spacedBy(10.dp),
+                horizontalAlignment = Alignment.Start,
+            ) {
+                Row(
+                    horizontalArrangement = Arrangement.spacedBy(10.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Box {
+                        HamburgerButton(
+                            size = s(48.dp),
+                            onClick = {
+                                markInteraction()
+                                menuOpen = true
+                            },
+                        )
+                        HamburgerDropdown(
+                            expanded = menuOpen,
+                            onDismiss = { menuOpen = false },
+                            onOpenSettings = {
+                                menuOpen = false
+                                settingsOpen = true
+                            },
+                            onKeyboard = {
+                                menuOpen = false
+                                SdlIme.toggle(ctx)
+                            },
+                            markInteraction = markInteraction,
+                        )
+                    }
+                    ModeToggleButton(size = s(48.dp), onInteract = markInteraction)
+                    KeyboardButton(size = s(48.dp), onInteract = markInteraction)
+                }
+                VirtualButton(
+                    label = "ESC",
+                    keyCode = KeyEvent.KEYCODE_ESCAPE,
+                    size = s(60.dp),
+                    shape = RoundedCornerShape(10.dp),
+                    bgColor = Color(0x66000000),
+                    borderColor = Color.White.copy(alpha = 0.4f),
+                    onInteract = markInteraction,
+                )
+            }
+
+            // ============ BOTTOM-LEFT: stick (Modern) or D-pad (Classic) ============
+            Box(
+                modifier = Modifier
+                    .align(Alignment.BottomStart)
+                    .padding(start = 36.dp, bottom = 36.dp)
+            ) {
+                when (mode) {
+                    ControlMode.MODERN -> AnalogStick(size = s(200.dp), onInteract = markInteraction)
+                    ControlMode.CLASSIC -> ClassicDPad(size = s(200.dp), onInteract = markInteraction)
+                }
+            }
+
+            // ============ BOTTOM-RIGHT: Thrust (Classic only) + Weapon + Special ============
+            // Weapon (primary) at bottom, Special (secondary) above, Thrust
+            // (Classic only) above Special. Placement mirrors mobile shoot-em-up
+            // conventions: the closer / larger button under the thumb is the
+            // most-used action. UQM Melee mashes Weapon far more often than
+            // Special, and Thrust is a hold-not-tap action so it lives at the
+            // top of the stack where the thumb can rest on it.
+            Column(
+                modifier = Modifier
+                    .align(Alignment.BottomEnd)
+                    .padding(end = 36.dp, bottom = 44.dp),
+                horizontalAlignment = Alignment.End,
+                verticalArrangement = Arrangement.spacedBy(20.dp),
+            ) {
+                // Classic-only Thrust ΓÇö same keycode (DPAD_UP) as the D-pad's
+                // Γåæ so UQM treats it as regular thrust; on Modern the analog
+                // stick already provides thrust via its own KEYCODE_DPAD_UP
+                // emission, so no extra button is needed.
+                if (mode == ControlMode.CLASSIC) {
+                    VirtualButton(
+                        label = "\u2191",
+                        keyCode = KeyEvent.KEYCODE_DPAD_UP,
+                        size = s(84.dp),
+                        shape = CircleShape,
+                        bgColor = Color(0x66225577),
+                        borderColor = Color(0xFF66CCFF),
+                        onInteract = markInteraction,
+                    )
+                }
+                VirtualButton(
+                    label = "S",
+                    keyCode = KeyEvent.KEYCODE_SHIFT_RIGHT,
+                    size = s(84.dp),
+                    shape = CircleShape,
+                    bgColor = Color(0x66884400),
+                    borderColor = Color(0xFFFFCC66),
+                    onInteract = markInteraction,
+                )
+                VirtualButton(
+                    label = "W",
+                    keyCode = KeyEvent.KEYCODE_ENTER,
+                    size = s(108.dp),
+                    shape = CircleShape,
+                    bgColor = Color(0x66004488),
+                    borderColor = Color(0xFF66CCFF),
+                    onInteract = markInteraction,
+                )
+            }
+        }
+
+        // ============ Settings dialog (top-most, not faded) ============
+        if (settingsOpen) {
+            OverlaySettingsDialog(onDismiss = { settingsOpen = false })
+        }
+    }
+}
