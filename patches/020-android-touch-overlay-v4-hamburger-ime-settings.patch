+// ---------------------------------------------------------------------------
+// Hamburger menu (Γÿ░) ΓÇö top-left, less-used hotkeys behind a dropdown
+// ---------------------------------------------------------------------------
+
+/**
+ * Static Γÿ░ icon button that only triggers a passed-in [onClick]. The
+ * anchored [DropdownMenu] is a sibling composable that reads its
+ * expanded state directly from [TouchOverlay]'s hoisted state.
+ *
+ * Kept simple (no key-event dispatch) because the button doesn't map to
+ * a UQM game action ΓÇö it's purely a Compose UI affordance.
+ */
+@Composable
+private fun HamburgerButton(size: Dp, onClick: () -> Unit) {
+    Box(
+        modifier = Modifier
+            .size(size)
+            .clip(RoundedCornerShape(10.dp))
+            .background(Color(0x66000000))
+            .border(2.dp, Color.White.copy(alpha = 0.5f), RoundedCornerShape(10.dp))
+            .pointerInput(Unit) {
+                awaitPointerEventScope {
+                    while (true) {
+                        val event = awaitPointerEvent(PointerEventPass.Initial)
+                        val ch = event.changes.firstOrNull() ?: continue
+                        if (!ch.pressed && ch.previousPressed) onClick()
+                        event.changes.forEach { if (it.pressed) it.consume() }
+                    }
+                }
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(
+            text = "\u2630",   // Γÿ░
+            color = Color.White,
+            style = TextStyle(fontSize = 22.sp, fontWeight = FontWeight.Bold),
+        )
+    }
+}
