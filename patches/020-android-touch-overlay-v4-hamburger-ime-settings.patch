+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        confirmButton = {
+            TextButton(onClick = onDismiss) { Text("Θù£Θûë") }
+        },
+        title = { Text("ΦÖ¢µô¼µîëΘêòΦ¿¡σ«Ü") },
+        text = {
+            Column {
