+// ---------------------------------------------------------------------------
+// Discrete button (Weapon / Special / ESC)
+// ---------------------------------------------------------------------------
+
+@Composable
+private fun VirtualButton(
+    label: String,
+    keyCode: Int,
+    size: Dp,
+    shape: androidx.compose.foundation.shape.CornerBasedShape,
+    bgColor: Color,
+    borderColor: Color,
+    onInteract: () -> Unit = {},
+) {
+    var pressed by remember { mutableStateOf(false) }
+    Box(
+        modifier = Modifier
+            .size(size)
+            .clip(shape)
+            .background(if (pressed) bgColor.copy(alpha = 0.85f) else bgColor)
+            .border(2.dp, borderColor, shape)
+            .pointerInput(keyCode) {
+                awaitPointerEventScope {
+                    while (true) {
+                        val event = awaitPointerEvent(PointerEventPass.Initial)
+                        val downNow = event.changes.any { it.pressed }
+                        // Dispatch synchronously; do not route through
+                        // LaunchedEffect(pressed) ΓÇö Compose may collapse a
+                        // same-frame down+up and never observe pressed=true.
+                        if (downNow && !pressed) {
+                            Log.i("UqmOverlay", "keydown $label (code=$keyCode)")
+                            SDLActivity.onNativeKeyDown(keyCode)
+                            onInteract()
+                            pressed = true
+                        } else if (!downNow && pressed) {
+                            Log.i("UqmOverlay", "keyup $label (code=$keyCode)")
+                            SDLActivity.onNativeKeyUp(keyCode)
+                            pressed = false
+                        }
+                        event.changes.forEach { if (it.pressed) it.consume() }
+                    }
+                }
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(
+            text = label,
+            color = Color.White.copy(alpha = 0.95f),
+            style = TextStyle(fontSize = 22.sp, fontWeight = FontWeight.Bold),
+        )
+    }
+}
