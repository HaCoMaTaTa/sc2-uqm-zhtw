+// ---------------------------------------------------------------------------
+// Analog stick
+// ---------------------------------------------------------------------------
+
+/**
+ * Virtual 360┬░ analog stick. Anchored at a fixed position; the knob follows
+ * the finger within [size]/2 radius. Stick displacement is translated into
+ * held keys via [computeKeys] and dispatched with pairwise Down/Up so
+ * transitions are clean even when Compose collapses frames.
+ */
+@Composable
+private fun AnalogStick(size: Dp, onInteract: () -> Unit = {}) {
+    val density = LocalDensity.current
+    val sizePx = with(density) { size.toPx() }
+    val radiusPx = sizePx / 2f
+    val knobRadiusPx = radiusPx * 0.42f
+
+    var offset by remember { mutableStateOf(Offset.Zero) }
+    // Set of Android keycodes currently held. Kept in sync via dispatchKeys().
+    val heldKeys = remember { HashSet<Int>() }
+
+    // Attach the SDL virtual joystick as soon as the analog stick is composed.
+    // Idempotent + defensive: the C side re-inits SDL_INIT_JOYSTICK if UQM's
+    // SDL_Init happened after us and the joystick subsystem is not yet up.
+    // The virtual joystick fires SDL_JOYDEVICEADDED which UQM's hotplug path
+    // picks up so `--dirjoystick=3` can bind to it.
+    LaunchedEffect(Unit) {
+        VirtualJoystick.ensureAttached()
+    }
+
+    fun dispatchKeys(target: Set<Int>) {
+        // Release keys no longer in target
+        val toRelease = heldKeys - target
+        for (k in toRelease) {
+            SDLActivity.onNativeKeyUp(k)
+            Log.d("UqmOverlay", "stick keyup ${keyName(k)}")
+        }
+        heldKeys.removeAll(toRelease)
+        // Press keys not yet held
+        val toPress = target - heldKeys
+        for (k in toPress) {
+            SDLActivity.onNativeKeyDown(k)
+            Log.d("UqmOverlay", "stick keydown ${keyName(k)}")
+        }
+        heldKeys.addAll(toPress)
+    }
+
+    Box(
+        modifier = Modifier
+            .size(size)
+            .pointerInput(Unit) {
+                awaitPointerEventScope {
+                    while (true) {
+                        val event = awaitPointerEvent(PointerEventPass.Initial)
+                        val ch = event.changes.firstOrNull()
+                        if (ch == null || !ch.pressed) {
+                            // Finger lifted or no active pointer ΓÇö recentre.
+                            if (offset != Offset.Zero) offset = Offset.Zero
+                            dispatchKeys(emptySet())
+                            VirtualJoystick.setAxes(0f, 0f)
+                        } else {
+                            // ch.position is in local coordinates (0,0) = top-left
+                            val center = Offset(sizePx / 2f, sizePx / 2f)
+                            val raw = ch.position - center
+                            offset = clampToRadius(raw, radiusPx)
+                            dispatchKeys(computeKeys(offset, radiusPx))
+                            // Feed normalized axes to UQM's directional joystick
+                            // path (--dirjoystick=3). SDL LEFTY convention is
+                            // "down positive" ΓÇö matches Compose screen y.
+                            val nx = offset.x / radiusPx
+                            val ny = offset.y / radiusPx
+                            VirtualJoystick.setAxes(nx, ny)
+                            onInteract()
+                        }
+                        // Consume so the underlying SDL surface does not also
+                        // interpret this as a mouse/touch event.
+                        event.changes.forEach { if (it.pressed) it.consume() }
+                    }
+                }
+            }
+    ) {
+        Canvas(modifier = Modifier.fillMaxSize()) {
+            val center = Offset(this.size.width / 2f, this.size.height / 2f)
+            // Base ring
+            drawCircle(
+                color = Color(0x33FFFFFF),
+                radius = radiusPx,
+                center = center,
+            )
+            drawCircle(
+                color = Color(0xAAFFFFFF),
+                radius = radiusPx,
+                center = center,
+                style = Stroke(width = 3f),
+            )
+            // Knob at current offset
+            drawCircle(
+                color = Color(0x9966CCFF),
+                radius = knobRadiusPx,
+                center = center + offset,
+            )
+            drawCircle(
+                color = Color.White.copy(alpha = 0.85f),
+                radius = knobRadiusPx,
+                center = center + offset,
+                style = Stroke(width = 2f),
+            )
+        }
+    }
+}
+
+private fun clampToRadius(v: Offset, r: Float): Offset {
+    val d = v.getDistance()
+    return if (d <= r) v else v * (r / d)
+}
+
+/**
+ * Translate stick displacement into the set of Android keycodes that should
+ * currently be held down. See KDoc on [TouchOverlay] for the menu-vs-combat
+ * compromise; this is where those numeric thresholds live.
+ *
+ * P2 (--dirjoystick=3) note: we deliberately do **not** emit keyboard LEFT /
+ * RIGHT here. The virtual SDL joystick (see [VirtualJoystick]) feeds UQM's
+ * GetDirectionalJoystickInput which drives auto-align turning in melee; if
+ * we also mashed keyboard LEFT / RIGHT the two sources would race and the
+ * ship would jitter. Menu-mode Left/Right navigation is provided by the
+ * dedicated `MenuArrowButton` composables next to ESC in [TouchOverlay].
+ */
+private fun computeKeys(offset: Offset, radius: Float): Set<Int> {
+    val magNorm = offset.getDistance() / radius
+    if (magNorm < 0.2f) return emptySet()  // dead zone
+
+    val xNorm = offset.x / radius
+    val yNorm = offset.y / radius  // screen coords: down = +y
+
+    val keys = HashSet<Int>()
+
+    // Menu carve-out: near-vertical push nearly-fully down ΓåÆ menu Down only.
+    // Requires both dominant downward and negligible horizontal component,
+    // so accidental down-right in combat still yields thrust.
+    val isNearlyStraightDown = yNorm > 0.7f && kotlin.math.abs(xNorm) < 0.15f
+    if (isNearlyStraightDown) {
+        keys.add(KeyEvent.KEYCODE_DPAD_DOWN)
+    } else {
+        // Any other push ΓåÆ thrust. Matches "wherever you push, ship goes".
+        keys.add(KeyEvent.KEYCODE_DPAD_UP)
+    }
+
+    // NOTE: no KEYCODE_DPAD_LEFT / KEYCODE_DPAD_RIGHT here ΓÇö see KDoc above.
+    // The virtual SDL joystick axes handle turning in combat, and dedicated
+    // MenuArrowButton composables handle menu Left/Right navigation.
+    return keys
+}
+
+private fun keyName(kc: Int): String = when (kc) {
+    KeyEvent.KEYCODE_DPAD_UP -> "UP"
+    KeyEvent.KEYCODE_DPAD_DOWN -> "DOWN"
+    KeyEvent.KEYCODE_DPAD_LEFT -> "LEFT"
+    KeyEvent.KEYCODE_DPAD_RIGHT -> "RIGHT"
+    KeyEvent.KEYCODE_ENTER -> "ENTER"
+    KeyEvent.KEYCODE_SHIFT_RIGHT -> "R-SHIFT"
+    KeyEvent.KEYCODE_ESCAPE -> "ESC"
+    else -> "?$kc"
+}
