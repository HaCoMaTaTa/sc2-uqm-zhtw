+/**
+ * DropdownMenu item that fires a SDL keydown+keyup pair on click and
+ * closes the parent menu. Convenience wrapper around DropdownMenuItem.
+ */
+@Composable
+private fun HotkeyMenuItem(
+    label: String,
+    keyCode: Int,
+    onDismiss: () -> Unit,
+    markInteraction: () -> Unit,
+) {
+    DropdownMenuItem(
+        text = { Text(label) },
+        onClick = {
+            markInteraction()
+            Log.i("UqmOverlay", "menu keydown $label (code=$keyCode)")
+            SDLActivity.onNativeKeyDown(keyCode)
+            SDLActivity.onNativeKeyUp(keyCode)
+            onDismiss()
+        },
+    )
+}
