+                Spacer(Modifier.height(8.dp))
+                Text(
+                    if (autoHide.toInt() == 0) "Φç¬σïòΘÜ▒ΦùÅ: σü£τö¿"
+                    else "Φç¬σïòΘÜ▒ΦùÅ: ${autoHide.toInt()} τºÆµ£¬µîë ΓåÆ µ╖íσç║"
+                )
+                Slider(
+                    value = autoHide,
+                    onValueChange = {
