+// ---------------------------------------------------------------------------
+// Keyboard button ΓÇö force-show the Android soft keyboard (IME)
+// ---------------------------------------------------------------------------
+
+/**
+ * Explicit "show soft keyboard" button. SDL2 Android normally pops the
+ * IME automatically on `SDL_StartTextInput()`, but the Compose overlay
+ * atop the SDL surface intercepts focus so the auto-show never fires.
+ * This button lets the player summon the keyboard manually ΓÇö used for:
+ *  - Captain / ship name entry at new game
+ *  - Star-map search (F6) text field
+ *  - Save game slot naming
+ *
+ * The keyboard delivers KEYDOWN / KEYUP / TEXTINPUT events straight to
+ * SDL2 (registered as global key listener during nativeSetupJNI). No
+ * plumbing required beyond calling [SdlIme.toggle].
+ */
+@Composable
+private fun KeyboardButton(size: Dp, onInteract: () -> Unit = {}) {
+    val ctx = LocalContext.current
+    Box(
+        modifier = Modifier
+            .size(size)
+            .clip(RoundedCornerShape(10.dp))
+            .background(Color(0x66004422))
+            .border(2.dp, Color(0xFF66CC88), RoundedCornerShape(10.dp))
+            .pointerInput(Unit) {
+                awaitPointerEventScope {
+                    while (true) {
+                        val event = awaitPointerEvent(PointerEventPass.Initial)
+                        val ch = event.changes.firstOrNull() ?: continue
+                        if (!ch.pressed && ch.previousPressed) {
+                            onInteract()
+                            SdlIme.toggle(ctx)
+                        }
+                        event.changes.forEach { if (it.pressed) it.consume() }
+                    }
+                }
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(
+            text = "\u2328",  // Γî¿
+            color = Color.White,
+            style = TextStyle(fontSize = 22.sp, fontWeight = FontWeight.Bold),
+        )
+    }
+}
