+/**
+ * Small square button that flips [OverlayPrefs.modeState] between MODERN
+ * and CLASSIC. Persists via SharedPreferences. Uses a Compose-friendly
+ * click detector (single tap on release) rather than the down-state
+ * dispatch pattern of [VirtualButton], because the toggle does UI state
+ * work rather than injecting SDL key events.
+ */
+@Composable
+private fun ModeToggleButton(size: Dp = 48.dp, onInteract: () -> Unit = {}) {
+    val mode by OverlayPrefs.modeState
+    val label = if (mode == ControlMode.MODERN) "M" else "C"
+    val subtitle = if (mode == ControlMode.MODERN) "modern" else "classic"
+
+    Box(
+        modifier = Modifier
+            .size(size)
+            .clip(RoundedCornerShape(10.dp))
+            .background(Color(0x66442200))
+            .border(2.dp, Color(0xFFFFAA44), RoundedCornerShape(10.dp))
+            .pointerInput(Unit) {
+                awaitPointerEventScope {
+                    while (true) {
+                        val event = awaitPointerEvent(PointerEventPass.Initial)
+                        val ch = event.changes.firstOrNull() ?: continue
+                        // Toggle on release (avoid rapid double-fire while held).
+                        if (!ch.pressed && ch.previousPressed) {
+                            OverlayPrefs.toggleMode()
+                            onInteract()
+                            Log.i("UqmOverlay", "mode toggled to ${OverlayPrefs.modeState.value}")
+                        }
+                        event.changes.forEach { if (it.pressed) it.consume() }
+                    }
+                }
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        Column(horizontalAlignment = Alignment.CenterHorizontally) {
+            Text(
+                text = label,
+                color = Color.White,
+                style = TextStyle(fontSize = 20.sp, fontWeight = FontWeight.Bold),
+            )
+            Text(
+                text = subtitle,
+                color = Color.White.copy(alpha = 0.7f),
+                style = TextStyle(fontSize = 8.sp),
+            )
+        }
+    }
+}
