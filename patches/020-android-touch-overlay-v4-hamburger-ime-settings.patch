+// ---------------------------------------------------------------------------
+// Pinch-to-zoom detector (full-screen underlay, Main pass)
+// ---------------------------------------------------------------------------
+
+/**
+ * Full-screen invisible layer that watches for two-finger pinch. When the
+ * distance between the two fingers changes by ┬▒30% of the initial baseline
+ * distance, injects one KEYCODE_PAGE_UP (spread) or KEYCODE_PAGE_DOWN
+ * (pinch) then resets the baseline. UQM's star-map default binding
+ * (menu.key: `zoom_in.2 = STRING:key Page Up`, `zoom_out.2 = STRING:key
+ * Page Down`) responds to those.
+ *
+ * Runs at [PointerEventPass.Main] so buttons and the analog stick get
+ * first dibs (they claim at [PointerEventPass.Initial] and consume their
+ * pointers). Only fires when we see ΓëÑ2 pressed pointers that were NOT
+ * consumed upstream.
+ *
+ * Also silently ignores pinches outside of star-map state ΓÇö UQM just
+ * ignores PAGE_UP/DOWN presses that have no meaning in the current
+ * screen, so no state-aware gating is required. Non-star-map screens
+ * (combat, dialog, hyperspace) will occasionally see stray PAGE_UP/DOWN
+ * events from user pinches; those are inert.
+ */
+@Composable
+private fun PinchZoomDetector() {
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .pointerInput(Unit) {
+                var baselineDist: Float = 0f
+                val pinchThresholdRatio = 0.30f
+                awaitPointerEventScope {
+                    while (true) {
+                        val event = awaitPointerEvent(PointerEventPass.Main)
+                        // Only unconsumed pressed pointers matter ΓÇö buttons /
+                        // stick have already claimed their fingers upstream.
+                        val active = event.changes.filter { it.pressed && !it.isConsumed }
+                        if (active.size < 2) {
+                            baselineDist = 0f
+                            continue
+                        }
+                        val a = active[0].position
+                        val b = active[1].position
+                        val dist = kotlin.math.hypot(a.x - b.x, a.y - b.y)
+                        if (baselineDist == 0f) {
+                            baselineDist = dist
+                            continue
+                        }
+                        val ratio = dist / baselineDist
+                        if (ratio > 1f + pinchThresholdRatio) {
+                            SDLActivity.onNativeKeyDown(KeyEvent.KEYCODE_PAGE_UP)
+                            SDLActivity.onNativeKeyUp(KeyEvent.KEYCODE_PAGE_UP)
+                            Log.d("UqmOverlay", "pinch spread ΓåÆ PAGE_UP")
+                            baselineDist = dist  // reset for next tier
+                        } else if (ratio < 1f - pinchThresholdRatio) {
+                            SDLActivity.onNativeKeyDown(KeyEvent.KEYCODE_PAGE_DOWN)
+                            SDLActivity.onNativeKeyUp(KeyEvent.KEYCODE_PAGE_DOWN)
+                            Log.d("UqmOverlay", "pinch close ΓåÆ PAGE_DOWN")
+                            baselineDist = dist
+                        }
+                    }
+                }
+            }
+    )
+}
+
+// ---------------------------------------------------------------------------
+// Classic D-pad (bottom-left, Classic mode alternative to AnalogStick)
+// ---------------------------------------------------------------------------
+
+/**
+ * Skeleton 4-way D-pad matching desktop UQM's default up/down/left/right
+ * key semantics. Each arrow is a discrete [VirtualButton] emitting the
+ * matching KEYCODE_DPAD_*. Layout is a plus-shape:
+ *
+ *     [ Γåæ ]
+ * [ΓåÉ] [   ] [ΓåÆ]
+ *     [ Γåô ]
+ *
+ * Intentionally minimal for the Stage 5 first pass ΓÇö no diagonal / 8-way
