+// zh-TW patch 031 helpers.
+// Detect if a UTF-8 string contains any CJK codepoint. Used to gate the
+// ZH-alias fallback in both FindNextStarIndex (search) and
+// DrawMatchedStarName (autocomplete) so ASCII-only queries retain the
+// exact upstream behaviour.
+static BOOLEAN
+ContainsCjk (const UNICODE *str)
+{
+	if (str == NULL)
+		return FALSE;
+	while (*str != '\0')
+	{
+		UniChar cc = getCharFromString (&str);
+		if ((cc >= 0x4E00 && cc <= 0x9FFF)      // CJK Unified Ideographs
+				|| (cc >= 0x3400 && cc <= 0x4DBF))  // CJK Extension A
+			return TRUE;
+	}
+	return FALSE;
+}
+
+// STAR_POSTFIX_ZH_BASE values are stored as "English（中文）" (fullwidth
+// brackets U+FF08 / U+FF09) so the star-map top-header can display both.
+// When the user is typing CJK we want autocomplete to show only the pure
+// Chinese portion — this parses out the bytes between the brackets.
+// Writes an empty string to `out` if brackets are missing or malformed.
+static void
+ExtractPureZh (const UNICODE *aliasStr, UNICODE *out, size_t outSize)
+{
+	const UNICODE *open;
+	const UNICODE *close;
+	size_t len;
+
+	if (outSize == 0)
+		return;
+	out[0] = '\0';
+	if (aliasStr == NULL)
+		return;
+
+	// U+FF08 「（」 → UTF-8 bytes EF BC 88 (3 bytes)
+	open = strstr (aliasStr, "\xEF\xBC\x88");
+	if (!open)
+		return;
+	open += 3;
+
+	// U+FF09 「）」 → UTF-8 bytes EF BC 89 (3 bytes)
+	close = strstr (open, "\xEF\xBC\x89");
+	if (!close)
+		return;
+
+	len = (size_t)(close - open);
+	if (len >= outSize)
+		len = outSize - 1;
+	memcpy (out, open, len);
+	out[len] = '\0';
+}
