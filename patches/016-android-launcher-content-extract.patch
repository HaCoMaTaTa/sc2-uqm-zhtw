+/**
+ * zh-TW Android port: hosts the launcher UI (Compose) and drives one-time
+ * content extraction from `assets/uqm-content/` into `getExternalFilesDir()`.
+ * When extraction completes, the "Start Game" button in [App] launches
+ * [EngineActivity] with the extracted content path in an Intent extra.
+ */
 class MainActivity : ComponentActivity() {
+
+    /** Reactive extraction state observed by the Compose launcher UI. */
+    val extractionState = mutableStateOf<ExtractionState>(ExtractionState.Idle)
+
+    /** Resolved once extraction succeeds; passed to [EngineActivity] as --contentdir. */
+    var contentDir: File? = null
+        private set
+
+    /** Resolved once extraction succeeds; passed to [EngineActivity] as --configdir. */
+    var userDir: File? = null
+        private set
+
     override fun onCreate(savedInstanceState: Bundle?) {
         enableEdgeToEdge()
         super.onCreate(savedInstanceState)
 
+        // scoped-storage friendly: no runtime permissions needed on API 24+
+        val user = File(getExternalFilesDir(null), "uqm-megamod")
+        val content = File(user, "content")
+        userDir = user
+        contentDir = content
+        user.mkdirs()
+
         CoroutineScope(Dispatchers.Main).launch {
-            PermissionHelper.getManageExternalStoragePermission(this@MainActivity)
+            extractionState.value = ExtractionState.Extracting("preparing", 0f)
+            val ok = withContext(Dispatchers.IO) {
+                UqmContentExtractor.ensureExtracted(this@MainActivity, content) { p ->
+                    val pct = if (p.bytesTotal > 0) p.bytesDone.toFloat() / p.bytesTotal else 0f
+                    extractionState.value = ExtractionState.Extracting(p.currentFile, pct)
+                }
+            }
+            extractionState.value =
+                if (ok) ExtractionState.Ready
+                else ExtractionState.Failed("content extraction failed — see logcat")
         }
 
         setContent {
-            App()
+            App(
+                extractionState = extractionState.value,
+                onStartGame = { loggingEnabled ->
+                    val c = contentDir ?: return@App
+                    val u = userDir ?: return@App
+                    startGame(
+                        isLoggingEnabled = loggingEnabled,
+                        contentDirPath = c.absolutePath,
+                        userDirPath = u.absolutePath,
+                    )
+                }
+            )
         }
     }
 }
+
+sealed class ExtractionState {
+    object Idle : ExtractionState()
+    data class Extracting(val currentFile: String, val progress: Float) : ExtractionState()
+    object Ready : ExtractionState()
+    data class Failed(val reason: String) : ExtractionState()
+}
