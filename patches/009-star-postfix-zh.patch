+// zh-TW patch 009: Chinese-localised variant of GetClusterName.
+// Same output layout as GetClusterName but reads the postfix from the
+// STAR_POSTFIX_ZH_BASE section (149 entries appended by zh-TW addon).
+// Gracefully falls back to the English postfix when the ZH entry is missing
+// or empty (which happens when the zh-TW addon is not loaded, or during
+// early boot before gamestrings finishes loading).
+// Prefix (Greek letter Alpha/Beta/...) is left in English per user spec.
+void
+GetClusterNameLocalized (const STAR_DESC *pSD, UNICODE buf[])
+{
+	UNICODE *pBuf, *pStr;
+
+	// Read the localized postfix first; if not available, use English path.
+	pStr = GAME_STRING (STAR_POSTFIX_ZH_BASE + pSD->Postfix);
+	if (pStr == NULL || pStr[0] == '\0')
+	{
+		GetClusterName (pSD, buf);
+		return;
+	}
+
+	pBuf = buf;
+	if (pSD->Prefix)
+	{
+		UNICODE *pfx = GAME_STRING (STAR_NUMBER_BASE + pSD->Prefix - 1);
+		if (pfx)
+		{
+			while ((*pBuf++ = *pfx++))
+				;
+			pBuf[-1] = ' ';
+		}
+	}
+	while ((*pBuf++ = *pStr++))
+		;
+}
+
